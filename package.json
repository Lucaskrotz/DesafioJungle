{
  "name": "distributed-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 60000 test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test --timeout 60000 --max-concurrency 1 test/integration",
    "test:concurrency": "bun test --timeout 120000 --max-concurrency 1 test/concurrency",
    "test:load": "bun test/load/load-test.ts",
    "migration:up": "bun src/infrastructure/mikro-orm/migrate.ts up",
    "migration:down": "bun src/infrastructure/mikro-orm/migrate.ts down",
    "infra:up": "docker compose up -d --wait postgres localstack",
    "infra:down": "docker compose down -v"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.700.0",
    "@mikro-orm/core": "^6.4.0",
    "@mikro-orm/migrations": "^6.4.0",
    "@mikro-orm/postgresql": "^6.4.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "decimal.js": "^10.4.3",
    "pino": "^9.5.0",
    "prom-client": "^15.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
